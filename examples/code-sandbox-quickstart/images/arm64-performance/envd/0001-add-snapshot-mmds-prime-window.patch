-	if !isNotFC {
+	noMMDSAPI := isNotFC || primeMMDSUntilUnix > 0
+	if primeMMDSUntilUnix > 0 {
+		mmdsCtx, stopMMDS := context.WithCancel(ctx)
+		go func() {
+			ticker := time.NewTicker(50 * time.Millisecond)
+			defer ticker.Stop()
+			for {
